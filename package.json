{
  "name": "adkit",
  "version": "1.0.0",
  "type": "module",
  "description": "This is an agnostic HTML Ad Building framework. It can build 970x250, 300x250 and 300x500 with expand panels. Initially this will be just be a CLI but will later grow into a browser UX/UI product. ",
  "keywords": [
    "Ad",
    "Building",
    "Ad",
    "AD",
    "Build",
    "Framework",
    "970x250",
    "300x250",
    "300x500",
    "expand",
    "panels"
  ],
  "bin": {
    "adkit": "dist/home.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lawrencedeguzman/Adkit.git"
  },
  "bugs": {
    "url": "https://github.com/lawrencedeguzman/Adkit/issues"
  },
  "license": "MIT",
  "author": "Larry de Guzman",
  "main": "src/home.ts",
  "scripts": {
    "test": "node --test",
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "tsx src/home.ts",
    "start": "node src/home.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "commander": "^15.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
