{
  "name": "adkit",
  "version": "1.0.0",
  "description": "This is an agnostic HTML Ad Building framework. It can build 970x250, 300x250 and 300x500 with expand panels. Initially this will be just be a CLI but will later grow into a browser UX/UI product. ",
  "keywords": [
    "Ad",
    "Building",
    "Ad",
    "AD",
    "Build",
    "Framework",
    "970x250",
    "300x250",
    "300x500",
    "expand",
    "panels"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lawrencedeguzman/Adkit.git"
  },
  "bugs": {
    "url": "https://github.com/lawrencedeguzman/Adkit/issues"
  },
  "license": "MIT",
  "author": "Larry de Guzman",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --test",
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "npm run build && node dist/index.js",
    "start": "node src/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
